[Unit]
Description=porthole desktop notifications
Documentation=man:porthole(1)
# Ends with the graphical session rather than outliving it: this exists to
# put a notification on a screen, and after the session there is no screen.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# The path docs/installing.md installs it to by hand, and the path
# crates/porthole-agent/tests/units.rs pins this line to. `make install`
# rewrites it to $(BINDIR)/porthole-agent in the copy it puts down -- the
# file here is unchanged -- so a PREFIX=/usr package's installed unit names
# /usr/bin. The XDG autostart entry beside this file needs no such edit,
# because a desktop entry's Exec= is looked up on $PATH and this is not.
ExecStart=/usr/local/bin/porthole-agent
# Restart=on-failure, and the exit statuses are what make it safe. The one
# failure this binary must survive -- a session with no notification service
# -- it survives by carrying on rather than by exiting. Every reason it stops
# at start-up exits 0: no session bus, no system bus, no notification
# interface, or a second agent already holding
# com.jacopobriccola.PortholeAgent. The unit therefore stays stopped and is
# never marked failed, and a headless login does not loop.
#
# The single non-zero exit is the system bus connection ending while the
# agent is running. It cannot rebuild that connection from inside its own
# loop, so what is left is a process nothing will ever wake again: closes
# stop being announced with no sign anything is wrong, which is the one way
# a notification agent's failure must not look.
#
# That cannot loop either, and for a reason worth stating rather than
# trusting to the start limit: the replacement agent tries the system bus
# during start-up. If it is still gone, that start-up failure exits 0, and
# on-failure does not restart a success. So this buys exactly one retry per
# loss, which is what a transient dbus-daemon restart needs.
Restart=on-failure
# Long enough not to hammer a bus that has genuinely gone, short enough that
# a user is not left without notifications for long.
RestartSec=5s

# porthole also ships data/porthole-agent.desktop, because desktops differ in
# which of the two they honour. A desktop that honours both starts two
# agents; the second finds the bus name taken, says so, and exits, so this
# unit and that file can both be installed without every close being
# announced twice.
#
# No hardening directives: the agent reads two buses and writes nothing. The
# privileged half is porthole-helper.service, which carries its own.

[Install]
WantedBy=graphical-session.target
